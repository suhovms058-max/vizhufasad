{
  "name": "vizhufasad-leads-api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node index.mjs",
    "start:api": "node index.mjs",
    "start:worker": "node worker.mjs",
    "check": "node --check index.mjs && node --check worker.mjs && node --check src/generation/processor.mjs && node --check src/generation/queue.mjs && node --check src/generation-quality/orchestrator.mjs && node --check src/generation-quality/providers.mjs && node --check src/payments/config.mjs && node --check src/payments/contract.mjs && node --check src/payments/providers/robokassa.mjs && node --check src/payments/repository.mjs && node --check src/payments/service.mjs && node --check src/payments/http.mjs && node --check src/payments/pages.mjs",
    "test": "node --test --test-concurrency=1",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:check": "drizzle-kit check --config=drizzle.config.mjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.mjs",
    "db:seed": "node src/seeds/tariff-plans.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "migrate:local-orders": "node scripts/migrate-local-orders.mjs",
    "cleanup:images": "node scripts/cleanup-project-images.mjs",
    "cleanup:generation-quality": "node scripts/cleanup-generation-quality.mjs",
    "regression:generation-quality": "node scripts/generation-quality-regression.mjs",
    "smoke:infra": "node --test test/infra.integration.test.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:photo-assessment": "node --test test/photo-assessment.integration.test.mjs",
    "smoke:wallet": "node --test test/wallet.integration.test.mjs",
    "smoke:payments": "node --test --test-concurrency=1 test/payments.provider.test.mjs test/payments.routes.test.mjs test/payments.integration.test.mjs",
    "smoke:queue": "node --test test/generation.queue.integration.test.mjs test/generation.integration.test.mjs",
    "smoke:generation-quality": "node --test test/generation-quality.golden.test.mjs test/generation-quality.integration.test.mjs test/generation.processor.test.mjs",
    "smoke:generation": "node scripts/smoke-standard-generation.mjs",
    "smoke:generation:endpoint": "node scripts/smoke-standard-generation-endpoint.mjs",
    "test:e2e": "playwright test",
    "test:frontend": "playwright test e2e/stage10-standard-flow.spec.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "ajv": "^8.20.0",
    "bullmq": "5.81.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "drizzle-orm": "0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "9.0.1",
    "pg": "^8.16.3",
    "redis": "^5.6.1",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "drizzle-kit": "^0.31.4"
  }
}
