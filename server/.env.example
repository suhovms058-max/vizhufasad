PORT=8080
HOST=0.0.0.0
DATA_DIR=./data
SITE_ORIGIN=https://suhovms058-max.github.io
MAX_BOT_TOKEN=
MAX_CHAT_ID=
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
LEADS_EMAIL=

# Passwordless auth. Generate AUTH_HASH_SECRET independently for every environment.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
AUTH_HASH_SECRET=
AUTH_MAIL_MODE=console
AUTH_EMAIL_FROM=
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_REQUEST_LIMIT=5
AUTH_CODE_VERIFY_LIMIT=10
AUTH_RATE_WINDOW_MS=900000
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=vizhufasad_session
AUTH_COOKIE_SECURE=false

# Data infrastructure. Local-only credentials match docker-compose defaults.
DATABASE_URL=postgresql://vizhufasad:vizhufasad_local@127.0.0.1:5432/vizhufasad
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=3000
HEALTH_CHECK_TIMEOUT_MS=4000
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vizhufasad
S3_SECRET_ACCESS_KEY=vizhufasad_local_secret
S3_BUCKET=vizhufasad-private
S3_FORCE_PATH_STYLE=true
S3_COMPATIBILITY_MODE=minio
S3_SIGNED_URL_TTL_SECONDS=300
S3_UPLOAD_URL_TTL_SECONDS=600
S3_CORS_ORIGINS=http://localhost:8080

# Project photo lifecycle.
IMAGE_UPLOAD_CLEANUP_HOURS=24
PROJECT_DELETION_RETENTION_DAYS=30

# Wallet and Stage 11 payment feature flags.
FEATURE_WALLET_ENABLED=true
FEATURE_TARIFF_CATALOG_ENABLED=true
FEATURE_FREE_BONUS_ENABLED=true
FEATURE_PAYMENTS_ENABLED=false
FEATURE_SUBSCRIPTIONS_ENABLED=false

# Robokassa one-off payments for a self-employed NPD merchant.
# Never commit real passwords. Test and production passwords are different.
PAYMENT_PROVIDER=robokassa
PAYMENT_TEST_MODE=true
# Required only when NODE_ENV=production and the staging server intentionally uses test payments.
PAYMENT_ALLOW_TEST_MODE_IN_PRODUCTION=false
PAYMENT_CHECKOUT_TTL_MINUTES=30
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
# Password #3 is needed only for provider API refunds.
ROBOKASSA_PASSWORD3=
ROBOKASSA_SIGNATURE_ALGORITHM=sha256
ROBOKASSA_CHECKOUT_URL=https://auth.robokassa.ru/Merchant/Index.aspx
ROBOKASSA_REFUND_URL=https://services.robokassa.ru/RefundService/Refund/Create
ROBOKASSA_REFUND_STATE_URL=https://services.robokassa.ru/RefundService/Refund/GetState
ROBOKASSA_OPERATION_STATE_URL=https://auth.robokassa.ru/Merchant/WebService/Service.asmx/OpStateExt
# Optional signed ResultUrl2 supplies OpKey needed for refunds.
ROBOKASSA_RESULT2_URL=
# Prefer a mounted certificate file; inline PEM remains available for platforms without files.
ROBOKASSA_RESULT2_PUBLIC_KEY_FILE=
ROBOKASSA_RESULT2_PUBLIC_KEY=
ROBOKASSA_RECURRING_APPROVED=false

# Published seller details. Required before FEATURE_PAYMENTS_ENABLED=true.
LEGAL_MERCHANT_NAME=
LEGAL_MERCHANT_INN=
LEGAL_MERCHANT_EMAIL=
LEGAL_MERCHANT_STATUS=Самозанятый, плательщик НПД

# Stage 7 Standard facade generation. Disabled until a production GenAPI key is configured.
FEATURE_STANDARD_GENERATION_ENABLED=false
# Stage 12 Pro stays off until its distinct model passes an approved live smoke.
FEATURE_PRO_GENERATION_ENABLED=false
FEATURE_GENERATION_EDITOR_ENABLED=false
GENERATION_PRIMARY_PROVIDER=genapi
GENERATION_FALLBACK_PROVIDER=none
GENERATION_PROVIDER_TIMEOUT_MS=180000
GENERATION_POLL_INTERVAL_MS=1500
GENERATION_RESULT_MAX_BYTES=26214400
GENERATION_RESULT_URL_TTL_SECONDS=300
GENERATION_QUEUE_NAME=facade-generation
GENERATION_QUEUE_PREFIX=vizhufasad
GENERATION_QUEUE_MAX_ATTEMPTS=3
GENERATION_QUEUE_BACKOFF_MS=5000
GENERATION_QUEUE_PAID_PRIORITY=1
GENERATION_QUEUE_FREE_PRIORITY=10
GENERATION_WORKER_CONCURRENCY=2
GENERATION_WORKER_LOCK_DURATION_MS=60000
GENERATION_WORKER_STALLED_INTERVAL_MS=30000
GENERATION_WORKER_MAX_STALLED_COUNT=2
GENERATION_WATCHDOG_INTERVAL_MS=30000
GENERATION_WATCHDOG_STALE_MS=180000
# Optional token for GET /internal/generation/metrics. Keep empty to disable the endpoint.
GENERATION_METRICS_TOKEN=
GENAPI_API_KEY=
GENAPI_ENDPOINT=https://api.gen-api.ru/api/v1
GENAPI_STANDARD_MODEL=nano-banana-2
# Conservative minor-RUB estimate per 1K request; one measured request cost 20.00 RUB.
GENAPI_STANDARD_ESTIMATED_COST_MINOR=2500
# Optional QC retry model. When set, candidate 1 uses the Standard model and the
# single free quality retry uses this different provider model.
GENAPI_STANDARD_RETRY_MODEL=
GENAPI_STANDARD_RETRY_ESTIMATED_COST_MINOR=2500
# Stage 12 candidate. Keep feature disabled until the approved live facade smoke passes.
# Must differ from Standard.
GENAPI_PRO_MODEL=nano-banana-pro
GENAPI_PRO_ESTIMATED_COST_MINOR=5000
# Text/scoped edit candidate. A separate model with a real mask field handles custom masks.
GENAPI_EDIT_MODEL=qwen-image-edit-plus
GENAPI_EDIT_ESTIMATED_COST_MINOR=2500
GENAPI_MASK_EDIT_MODEL=bria-genfill
GENAPI_MASK_EDIT_ESTIMATED_COST_MINOR=1500
GENAPI_COST_CURRENCY=RUB

# Stage 12 real 4K export. Keep disabled until a paid DRCT smoke confirms dimensions and artifacts.
FEATURE_UPSCALE_4K_ENABLED=false
UPSCALE_PROVIDER=genapi
GENAPI_UPSCALE_MODEL=drct-super-resolution
GENAPI_UPSCALE_FACTOR=4
GENAPI_UPSCALE_ESTIMATED_COST_MINOR=1000
UPSCALE_TIMEOUT_MS=240000
UPSCALE_POLL_INTERVAL_MS=1500
UPSCALE_RESULT_MAX_BYTES=52428800
UPSCALE_RESULT_URL_TTL_SECONDS=300
UPSCALE_QUEUE_NAME=facade-upscale
UPSCALE_QUEUE_MAX_ATTEMPTS=2
UPSCALE_QUEUE_BACKOFF_MS=5000
UPSCALE_WORKER_CONCURRENCY=1

# Staging endpoint is forbidden in production and requires a random secret of at least 24 chars.
GENERATION_STAGING_ENABLED=false
GENERATION_STAGING_SECRET=
# The live smoke script also requires an explicit opt-in.
GENERATION_LIVE_SMOKE_ENABLED=false
GENERATION_SMOKE_FIXTURES_DIR=D:\VIZHUFASAD\stage7-private-facades
GENERATION_SMOKE_OUTPUT_DIR=D:\VIZHUFASAD\stage7-generation-results
GENERATION_SMOKE_IMAGE_LIMIT=3
GENERATION_SMOKE_IMAGE_OFFSET=0
GENERATION_SMOKE_MODELS=nano-banana-2
GENERATION_SMOKE_BUDGET_MINOR=30000

# Explicit paths/actions and a separately approved budget are mandatory for paid Stage 12 smokes.
STAGE12_SMOKE_ACTIONS=
STAGE12_SMOKE_SOURCE_IMAGE=
STAGE12_SMOKE_EDIT_BASE_IMAGE=
STAGE12_SMOKE_MASK_IMAGE=
STAGE12_SMOKE_OUTPUT_DIR=D:\VIZHUFASAD\stage12-smoke-results
STAGE12_SMOKE_BUDGET_MINOR=1

# Stage 9 mandatory automatic generation quality gate.
# When FEATURE_STANDARD_GENERATION_ENABLED=true, this gate and a configured VLM are required.
GENERATION_QUALITY_ENABLED=true
GENERATION_QUALITY_PRIMARY_PROVIDER=auto
GENERATION_QUALITY_FALLBACK_PROVIDER=auto
GENERATION_QUALITY_YANDEX_MODEL=qwen3.6-35b-a3b
GENERATION_QUALITY_OPENAI_MODEL=gpt-4.1-mini
GENERATION_QUALITY_TIMEOUT_MS=45000
GENERATION_QUALITY_PRIMARY_ATTEMPTS=2
GENERATION_QUALITY_RETRY_DELAY_MS=500
GENERATION_QUALITY_DIAGNOSTIC_RETENTION_HOURS=72
GENERATION_QUALITY_DIAGNOSTIC_URL_TTL_SECONDS=300
# Optional token for read-only admin diagnostics. Keep empty to disable the endpoint.
GENERATION_QUALITY_ADMIN_TOKEN=
# Scores are basis points from 0 to 10000.
GENERATION_QUALITY_MIN_OVERALL=7600
GENERATION_QUALITY_MIN_SAME_HOUSE=8500
GENERATION_QUALITY_MIN_PROTECTED_ELEMENT=7000
GENERATION_QUALITY_MIN_CONTOURS=6800
GENERATION_QUALITY_MIN_SPATIAL_LAYOUT=7000
GENERATION_QUALITY_MIN_PROTECTED_ZONES=6800
GENERATION_QUALITY_MIN_ARTIFACTS=7500
GENERATION_QUALITY_MIN_STYLE=6500

# Keep the public lead form working during migration. Switch to disabled only after production cutover.
LEGACY_LEADS_MODE=deprecated
# Optional RFC 7231 date, for example: Wed, 30 Sep 2026 21:00:00 GMT
LEGACY_LEADS_SUNSET=

# Необязательно. Без ключа заявки продолжают работать без ИИ-проверки.
# Ключи хранить только в .env на сервере и никогда не загружать в GitHub.
PHOTO_ASSESSMENT_PRIMARY_PROVIDER=auto
PHOTO_ASSESSMENT_FALLBACK_PROVIDER=auto
PHOTO_ASSESSMENT_TIMEOUT_MS=45000
PHOTO_ASSESSMENT_PRIMARY_ATTEMPTS=2
PHOTO_ASSESSMENT_RETRY_DELAY_MS=500
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=qwen3.6-35b-a3b

# Резервный провайдер. На сервере в неподдерживаемом регионе OpenAI вернёт 403.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
