PORT=8080
DATA_DIR=./data
SITE_ORIGIN=https://suhovms058-max.github.io
MAX_BOT_TOKEN=
MAX_CHAT_ID=
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
LEADS_EMAIL=

# Passwordless auth. Generate AUTH_HASH_SECRET independently for every environment.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
AUTH_HASH_SECRET=
AUTH_MAIL_MODE=console
AUTH_EMAIL_FROM=
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_REQUEST_LIMIT=5
AUTH_CODE_VERIFY_LIMIT=10
AUTH_RATE_WINDOW_MS=900000
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=vizhufasad_session
AUTH_COOKIE_SECURE=false

# Data infrastructure. Local-only credentials match docker-compose defaults.
DATABASE_URL=postgresql://vizhufasad:vizhufasad_local@127.0.0.1:5432/vizhufasad
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=3000
HEALTH_CHECK_TIMEOUT_MS=4000
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=vizhufasad
S3_SECRET_ACCESS_KEY=vizhufasad_local_secret
S3_BUCKET=vizhufasad-private
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300
S3_UPLOAD_URL_TTL_SECONDS=600
S3_CORS_ORIGINS=http://localhost:8080

# Project photo lifecycle.
IMAGE_UPLOAD_CLEANUP_HOURS=24
PROJECT_DELETION_RETENTION_DAYS=30

# Stage 6 feature flags. Payments must stay false until a provider is implemented.
FEATURE_WALLET_ENABLED=true
FEATURE_TARIFF_CATALOG_ENABLED=true
FEATURE_FREE_BONUS_ENABLED=true
FEATURE_PAYMENTS_ENABLED=false

# Stage 7 Standard facade generation. Disabled until a production GenAPI key is configured.
FEATURE_STANDARD_GENERATION_ENABLED=false
GENERATION_PRIMARY_PROVIDER=genapi
GENERATION_FALLBACK_PROVIDER=none
GENERATION_PROVIDER_TIMEOUT_MS=180000
GENERATION_POLL_INTERVAL_MS=1500
GENERATION_RESULT_MAX_BYTES=26214400
GENERATION_RESULT_URL_TTL_SECONDS=300
GENERATION_QUEUE_NAME=facade-generation
GENERATION_QUEUE_PREFIX=vizhufasad
GENERATION_QUEUE_MAX_ATTEMPTS=3
GENERATION_QUEUE_BACKOFF_MS=5000
GENERATION_QUEUE_PAID_PRIORITY=1
GENERATION_QUEUE_FREE_PRIORITY=10
GENERATION_WORKER_CONCURRENCY=2
GENERATION_WORKER_LOCK_DURATION_MS=60000
GENERATION_WORKER_STALLED_INTERVAL_MS=30000
GENERATION_WORKER_MAX_STALLED_COUNT=2
GENERATION_WATCHDOG_INTERVAL_MS=30000
GENERATION_WATCHDOG_STALE_MS=180000
# Optional token for GET /internal/generation/metrics. Keep empty to disable the endpoint.
GENERATION_METRICS_TOKEN=
GENAPI_API_KEY=
GENAPI_ENDPOINT=https://api.gen-api.ru/api/v1
GENAPI_STANDARD_MODEL=nano-banana-2
# Conservative minor-RUB estimate per 1K request; one measured request cost 20.00 RUB.
GENAPI_STANDARD_ESTIMATED_COST_MINOR=2500
GENAPI_COST_CURRENCY=RUB

# Staging endpoint is forbidden in production and requires a random secret of at least 24 chars.
GENERATION_STAGING_ENABLED=false
GENERATION_STAGING_SECRET=
# The live smoke script also requires an explicit opt-in.
GENERATION_LIVE_SMOKE_ENABLED=false
GENERATION_SMOKE_FIXTURES_DIR=D:\VIZHUFASAD\stage7-private-facades
GENERATION_SMOKE_OUTPUT_DIR=D:\VIZHUFASAD\stage7-generation-results
GENERATION_SMOKE_IMAGE_LIMIT=3
GENERATION_SMOKE_IMAGE_OFFSET=0
GENERATION_SMOKE_MODELS=nano-banana-2
GENERATION_SMOKE_BUDGET_MINOR=30000

# Keep the public lead form working during migration. Switch to disabled only after production cutover.
LEGACY_LEADS_MODE=deprecated
# Optional RFC 7231 date, for example: Wed, 30 Sep 2026 21:00:00 GMT
LEGACY_LEADS_SUNSET=

# Необязательно. Без ключа заявки продолжают работать без ИИ-проверки.
# Ключи хранить только в .env на сервере и никогда не загружать в GitHub.
PHOTO_ASSESSMENT_PRIMARY_PROVIDER=auto
PHOTO_ASSESSMENT_FALLBACK_PROVIDER=auto
PHOTO_ASSESSMENT_TIMEOUT_MS=45000
PHOTO_ASSESSMENT_PRIMARY_ATTEMPTS=2
PHOTO_ASSESSMENT_RETRY_DELAY_MS=500
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=qwen3.6-35b-a3b

# Резервный провайдер. На сервере в неподдерживаемом регионе OpenAI вернёт 403.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
