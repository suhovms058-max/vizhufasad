# Public frontend configuration. This value is embedded into the static build.
NEXT_PUBLIC_LEADS_API_URL=https://89-23-97-248.sslip.io/api/leads

# Local docker-compose infrastructure. Change every value outside local development.
POSTGRES_DB=vizhufasad
POSTGRES_USER=vizhufasad
POSTGRES_PASSWORD=vizhufasad_local
POSTGRES_PORT=5432
REDIS_PORT=6379
# Redis is configured by docker-compose with AOF every second and noeviction for BullMQ safety.
MINIO_ROOT_USER=vizhufasad
MINIO_ROOT_PASSWORD=vizhufasad_local_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=vizhufasad-private
S3_CORS_ORIGINS=http://localhost:8080

# Application-only Stage 7 secrets belong in server/.env, never in this Docker Compose file.
# See server/.env.example for GENAPI_API_KEY and Standard generation settings.

# Passwordless auth. Generate AUTH_HASH_SECRET independently for every environment.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NODE_ENV=development
AUTH_HASH_SECRET=
AUTH_MAIL_MODE=console
AUTH_EMAIL_FROM=
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_REQUEST_LIMIT=5
AUTH_CODE_VERIFY_LIMIT=10
AUTH_RATE_WINDOW_MS=900000
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=vizhufasad_session
AUTH_COOKIE_SECURE=false
